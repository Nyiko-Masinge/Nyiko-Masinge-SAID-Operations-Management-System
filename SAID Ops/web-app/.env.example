# Firebase public client configuration for the integrated supervisor app.
# These are blank intentionally; use real public client config in an ignored local .env.local.
# Never put Admin SDK credentials or private keys in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Explicit emulator opt-in; normal Firebase remains the default.
# Enabled mode requires a demo- project ID and all three endpoints below.
# Use your development machine's reachable LAN host for a physical mobile device.
NEXT_PUBLIC_FIREBASE_EMULATORS_ENABLED=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=

# Explicit durable workforce/templates + trusted publication mode; fixture keeps local demos.
NEXT_PUBLIC_ROSTER_BACKEND=fixture
# Live roster defaults to genuine monitoring. Choose memory only for explicit local demos.
NEXT_PUBLIC_MONITORING_BACKEND=memory
# Server-only planning/publisher settings. No Admin credential belongs in NEXT_PUBLIC_*.
SAID_ROSTER_BACKEND=fixture
SAID_FIREBASE_EMULATORS_ENABLED=false
SAID_FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
# Non-emulator Admin uses server-side Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS points to an external credential file; never commit it.
# Vercel server-only credential alternative to Application Default Credentials.
SAID_FIREBASE_SERVICE_ACCOUNT_JSON=
