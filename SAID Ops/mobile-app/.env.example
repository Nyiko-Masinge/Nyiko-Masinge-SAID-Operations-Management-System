# Firebase public client configuration for the integrated staff app.
# These are blank intentionally; use real public client config in an ignored local .env.
# Never put Admin SDK credentials or private keys in an Expo client environment.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Explicit emulator opt-in; normal Firebase remains the default.
# Enabled mode requires a demo- project ID and all three endpoints below.
# Use your development machine's reachable LAN host for a physical mobile device.
EXPO_PUBLIC_FIREBASE_EMULATORS_ENABLED=false
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=

# Explicit current published roster reads; Firebase configuration alone is insufficient.
EXPO_PUBLIC_ROSTER_BACKEND=fixture

# Persistent in-app notifications: select firestore explicitly for the live channel.
EXPO_PUBLIC_MONITORING_BACKEND=memory

# Trusted Next API origin; required for live progress. Set the deployed origin after deployment.
# Local HTTP origins are accepted only with explicit emulator mode.
EXPO_PUBLIC_API_BASE_URL=
